# EmailJS credentials for the contact form (wired up in a later phase).
# Copy this file to `.env`, fill in the values from your EmailJS dashboard,
# then restart the dev server. Vite only exposes vars prefixed with VITE_.
# The real `.env` is gitignored — never commit your keys.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
